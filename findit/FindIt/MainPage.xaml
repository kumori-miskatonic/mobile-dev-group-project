<ContentPage x:Class="FindIt.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Label Text="FindIt" FontSize="32" FontAttributes="Bold" />
            <Label Text="Campus Lost &amp; Found Management" FontSize="16" />

            <Border Padding="16" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="FormTitleLabel" Text="Register Found Item" FontSize="21" FontAttributes="Bold" />
                    <Entry x:Name="ItemNameEntry" Placeholder="Item name" />
                    <Editor x:Name="DescriptionEditor" Placeholder="Description" AutoSize="TextChanges" MinimumHeightRequest="80" />
                    <Entry x:Name="LocationEntry" Placeholder="Location found" />
                    <DatePicker x:Name="DateFoundPicker" />
                    <Picker x:Name="StatusPicker" Title="Status" SelectedIndex="0">
                        <Picker.Items>
                            <x:String>Unclaimed</x:String>
                            <x:String>Claimed</x:String>
                        </Picker.Items>
                    </Picker>
                    <Entry x:Name="ModifiedByEntry" Placeholder="Staff member name" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="SaveButton" Grid.Column="0" Text="Create Item" Clicked="OnSaveClicked" />
                        <Button x:Name="CancelButton" Grid.Column="1" Text="Cancel Edit" IsVisible="False" Clicked="OnCancelClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Active Items" FontSize="23" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                <BindableLayout.EmptyView>
                    <Label Text="No active lost items yet. Create one above." Padding="8" FontAttributes="Italic" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding ItemName}" FontSize="19" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold" TextColor="#2563EB" />
                                </Grid>
                                <Label Text="{Binding Description}" />
                                <Label Text="{Binding LocationFound, StringFormat='Found at: {0}'}" />
                                <Label Text="{Binding DateFound, StringFormat='Date found: {0:MMM d, yyyy}'}" />
                                <Label Text="{Binding ModifiedBy, StringFormat='Last modified by: {0}'}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                                    <Button Grid.Column="0" Text="Edit" CommandParameter="{Binding .}" Clicked="OnEditClicked" />
                                    <Button Grid.Column="1" Text="Delete" BackgroundColor="#B42318" TextColor="White" CommandParameter="{Binding .}" Clicked="OnDeleteClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Padding="16" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Server Synchronization" FontSize="21" FontAttributes="Bold" />
                    <Label Text="Use your computer's LAN address when testing on a physical phone." FontSize="13" />
                    <Entry x:Name="ServerUrlEntry" Text="http://10.0.2.2:5187" Placeholder="http://computer-ip:5187" Keyboard="Url" />
                    <Label x:Name="PendingCountLabel" Text="Pending changes: 0" FontAttributes="Bold" />
                    <Button x:Name="SyncButton" Text="Send Pending Changes" Clicked="OnSyncClicked" />
                    <Label x:Name="SyncStatusLabel" Text="Changes are cleared only after server confirmation." FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Change Tracking" FontSize="23" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Changes}" Spacing="8">
                <BindableLayout.EmptyView>
                    <Label Text="No changes recorded yet." Padding="8" FontAttributes="Italic" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ChangeType}" FontAttributes="Bold" TextColor="#2563EB" />
                                <Label Text="{Binding Summary}" />
                                <Label Text="{Binding ModifiedBy, StringFormat='Changed by: {0}'}" />
                                <Label Text="{Binding ChangedAt, StringFormat='UTC: {0:yyyy-MM-dd HH:mm:ss}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
